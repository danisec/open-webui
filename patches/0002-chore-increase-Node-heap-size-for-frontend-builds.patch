From: Dani Aprilyanto <daniaprilyanto35@gmail.com>
Date: Fri, 2 Oct 2026 01:37:35 +0000
Subject: [PATCH 02/12] chore: increase Node heap size for frontend builds

---
 Dockerfile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Dockerfile b/Dockerfile
index 08d7a71ee..94bc5f92e 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -31,7 +31,7 @@ ARG UID
 ARG GID
 
 # Set Node.js options (heap limit Allocation failed - JavaScript heap out of memory)
-# ENV NODE_OPTIONS="--max-old-space-size=4096"
+ENV NODE_OPTIONS="--max-old-space-size=8192"
 
 WORKDIR /app
 
